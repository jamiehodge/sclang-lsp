-void PyrCurryArgNode::dump(int level) { postfl("%2d CurryArg %d\n", level, mArgNum); }
+void PyrCurryArgNode::dump(int level) {
+    postfl("%2d CurryArg %d\n", level, mArgNum);
+    // Every other node dumps its mNext; this one did not, so an argument list
+    // was truncated at the first `_` and everything after it vanished.
+    DUMPNODE(mNext, level);
+}
 
 void PyrSlotNode::dump(int level) {
     if (mClassno == pn_PushLitNode)
@@ -78,9 +83,22 @@ void PyrClassNode::dump(int level) {
 }
 
 void PyrMethodNode::dump(int level) {
-    postfl("%2d MethodNode '%s'  %s\n", level, slotRawSymbol(&mMethodName->mSlot)->name,
+    // Mark class methods with a leading `*`, as the source does. Without it a
+    // class and instance method of the same name are indistinguishable, which
+    // they routinely are — Environment has both `*make` and `make`.
+    postfl("%2d MethodNode '%s%s'  %s\n", level, mIsClassMethod ? "*" : "",
+           slotRawSymbol(&mMethodName->mSlot)->name,
            mPrimitiveName ? slotRawSymbol(&mPrimitiveName->mSlot)->name : "");
     DUMPNODE(mArglist, level + 1);
+    // Variable declarations were omitted here, so a method's `var x = ...`
+    // initialisers never appeared in the dump.
+    //
+    // Dump the VarDef chain directly rather than the PyrVarListNode. The chain
+    // already spans every `var` statement in the method, while each VarList
+    // after the first points partway along it — so dumping the list chain
+    // repeats the tail of the declarations.
+    if (mVarlist)
+        DUMPNODE(mVarlist->mVarDefs, level + 1);
     DUMPNODE(mBody, level + 1);
     DUMPNODE(mNext, level);
 }
@@ -132,7 +150,10 @@ void PyrSlotNode::dumpPushLit(int level) {
     if (!IsPtr(&mSlot))
         dumpPyrSlot(&mSlot);
     else {
-        DUMPNODE((PyrParseNode*)slotRawObject(&mSlot), level);
+        // The slot was filled with SetPtr (newPyrPushLitNode), so it has to be
+        // read back with slotRawPtr. Reading it as an object meant function
+        // literals never dumped at all.
+        DUMPNODE((PyrParseNode*)slotRawPtr(&mSlot), level);
     }
 }
 
@@ -141,7 +162,10 @@ void PyrSlotNode::dumpLiteral(int level) {
     if (!IsPtr(&mSlot))
         dumpPyrSlot(&mSlot);
     else {
-        DUMPNODE((PyrParseNode*)slotRawObject(&mSlot), level);
+        // The slot was filled with SetPtr (newPyrPushLitNode), so it has to be
+        // read back with slotRawPtr. Reading it as an object meant function
+        // literals never dumped at all.
+        DUMPNODE((PyrParseNode*)slotRawPtr(&mSlot), level);
     }
 }
 
@@ -208,6 +232,15 @@ void PyrLitListNode::dump(int level) {
 void PyrBlockNode::dump(int level) {
     postfl("%2d Func\n", level);
     DUMPNODE(mArglist, level + 1);
+    // Variable declarations were omitted here, so a method's `var x = ...`
+    // initialisers never appeared in the dump.
+    //
+    // Dump the VarDef chain directly rather than the PyrVarListNode. The chain
+    // already spans every `var` statement in the method, while each VarList
+    // after the first points partway along it — so dumping the list chain
+    // repeats the tail of the declarations.
+    if (mVarlist)
+        DUMPNODE(mVarlist->mVarDefs, level + 1);
     DUMPNODE(mBody, level + 1);
     DUMPNODE(mNext, level);
 }
